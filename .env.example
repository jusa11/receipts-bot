# Copy this file to .env and fill the local values. Never put live keys here.
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=

# Yandex Vision OCR
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_OCR_MODEL=page
YANDEX_OCR_LANGUAGES=ru,en

# Optional model credentials/settings. If omitted, the OCR key and folder are reused.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_MODEL=aliceai-llm

# Frozen category snapshot; Google Sheets will replace this local source later.
CATEGORIES_PATH=./receipt_bot/data/categories.json
DATA_DIR=./data
MAX_IMAGE_BYTES=10485760
HTTP_TIMEOUT_SECONDS=45

# Optional Google Sheets test-copy integration. Share this spreadsheet with
# the service account's client_email as Editor. Keep the JSON key local.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
